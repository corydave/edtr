{
  "name": "SNDEDTR - browser audio editor",
  "short_name": "SNDEDTR",
  "description": "A multitrack audio editor that runs entirely in your browser. Files you open are decoded on your own machine and are never uploaded.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#101319",
  "theme_color": "#101319",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "music", "utilities"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "./",
      "name": "Audio file",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "accept": {
        "audio/wav": [".wav"],
        "audio/x-wav": [".wav"],
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/flac": [".flac"],
        "audio/webm": [".webm"]
      }
    }
  ]
}
