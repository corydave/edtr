{
  "name": "GAMEDTR",
  "short_name": "GAMEDTR",
  "description": "Make your own 2D games with blocks, pixel art and chiptune sound. Runs entirely in your browser, with no account and nothing uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#991b1b",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-gamedtr": [".gamedtr"]
      }
    }
  ]
}
