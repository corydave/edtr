{
  "name": "3DEDTR",
  "short_name": "3DEDTR",
  "description": "3D modeling with shape merging (union, subtract, intersect) that runs entirely in your browser. Export STL for 3D printing.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#7a4100",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/stl": [".stl"],
        "model/obj": [".obj"],
        "model/gltf+json": [".gltf"],
        "model/gltf-binary": [".glb"],
        "application/x-3dedtr": [".3dedtr"]
      }
    }
  ]
}
