{
  "name": "TELEDTR",
  "short_name": "TELEDTR",
  "description": "A teleprompter: write a script, time it, and read it full screen while you record. Runs entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1318",
  "theme_color": "#facc15",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-teledtr": [".teledtr"] }
    }
  ]
}
