{
  "name": "DSKEDTR",
  "short_name": "DSKEDTR",
  "description": "Desktop publishing in your browser: newsletters, flyers and booklets, with text that flows between boxes. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#065f46",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-dskedtr": [".dskedtr"], "application/x-mspublisher": [".pub"] }
    }
  ]
}
